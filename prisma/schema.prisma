generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  passwordEncrypted String?
  role          String         @default("user")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  folders       Folder[]
  settings       Setting[]
  patientProfile PatientProfile?  @relation("PatientUser")
  supervisedPatients PatientProfile[] @relation("ResponsibleAdmin")
  
  // Usage limits fields
  usageLimit    Int            @default(15)
  usageUsed     Int            @default(0)
  usageResetAt  DateTime       @default(now())

  // Posture App relations
  postureAppointments PostureAppointment[]
  postureSessions     PostureSession[]
  postureTestResults  PostureTestResult[]
}

model Conversation {
  id         String    @id @default(cuid())
  userId     String
  folderId   String?
  title      String    @default("Yeni Sohbet")
  aiProvider String    @default("openai")
  aiModel    String    @default("gpt-4.1")
  shareId    String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages   Message[]
}

model Folder {
  id            String         @id @default(cuid())
  userId        String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  provider       String?
  model          String?
  status         String       @default("done")
  errorMessage   String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    Attachment[]
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String?
  fileName  String
  mimeType  String
  filePath  String
  fileSize  Int
  createdAt DateTime @default(now())
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Setting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model PatientProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation("PatientUser", fields: [userId], references: [id], onDelete: Cascade)
  responsibleAdminId  String?
  responsibleAdmin    User?    @relation("ResponsibleAdmin", fields: [responsibleAdminId], references: [id], onDelete: SetNull)
  photo               String?
  age                 Int?
  phone               String?
  gender              String?
  shortDescription    String?
  longDetails         String?
  clinicalOpinion     String?
  videoLinks          String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── Posture App Models ─────────────────────────────────────────────────────

/// Randevu kodu → User eşleştirmesi. Admin tarafından oluşturulur.
model PostureAppointment {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentCode String    @unique
  isUsed          Boolean   @default(false)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([appointmentCode])
}

/// Bir değerlendirme oturumu (4 modülün tamamı = 1 session)
model PostureSession {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentCode String?
  deviceInfo      String?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  testResults     PostureTestResult[]

  @@index([userId])
}

/// Her modülün sonucu (front_static_posture, shoulder_flexion vb.)
model PostureTestResult {
  id             String               @id @default(cuid())
  sessionId      String
  session        PostureSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  testType       String
  overallQuality String
  avgConfidence  Float                @default(0)
  createdAt      DateTime             @default(now())
  measurements   PostureMeasurement[]

  @@index([sessionId])
  @@index([userId])
}

/// Her test içindeki bireysel metrikler (shoulderLevelAngle, leftShoulderROM vb.)
model PostureMeasurement {
  id           String            @id @default(cuid())
  testResultId String
  testResult   PostureTestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  metricKey    String
  value        Float
  unit         String            @default("")
  confidence   Float             @default(0)
  quality      String            @default("acceptable")
  createdAt    DateTime          @default(now())

  @@index([testResultId])
}

